<?php

/**
 * @file
 * Hooks for install and uninstall.
 */

use Drupal\Core\File\FileExists;
use Drupal\Core\File\FileSystemInterface;

/**
 * Implements hook_install().
 */
function bunny_stream_install(): void {
  $path = \Drupal::service('extension.list.module')->getPath('bunny_stream') . '/images/icon/no-thumbnail.png';

  $directory = \Drupal::config('media.settings')->get('icon_base_uri');

  $fileSystem = \Drupal::service(FileSystemInterface::class);
  $fileSystem->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  $fileSystem->copy($path, $directory . '/bunny.png', FileExists::Replace);
}

/**
 * Implements hook_uninstall().
 */
function bunny_stream_uninstall(): void {
  $directory = \Drupal::config('media.settings')->get('icon_base_uri');
  \Drupal::service(FileSystemInterface::class)->delete($directory . '/bunny.png');
}

/**
 * Removes the webhook hash configuration.
 */
function bunny_stream_update_11001(): string {
  // Webhooks are sent to /bunny-stream/webhook and
  // verified with HMAC signature.
  $config_factory = \Drupal::configFactory();
  foreach (['bunny_stream.config', 'bunny_stream.settings'] as $name) {
    $config_factory->getEditable($name)->delete();
  }
  return (string) t('Update the Bunny webhook URL to /bunny-stream/webhook and set the read-only API key on each library.');
}
